{
  "mcpServers": {
    "unity-mcp": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/unity-mcp-server/src/index.js"
      ]
    },
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender==2.3.1"
      ],
      "env": {
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
